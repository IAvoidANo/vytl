// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ORGANISATION & USER MANAGEMENT
// ============================================

model Organisation {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  industry         String?
  employeeCount    Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // POPIA compliance
  dataRetentionDays Int      @default(2555)
  consentGiven      Boolean  @default(false)
  consentDate       DateTime?

  // Risk Appetite (King V / ISO 31000)
  appetiteStatement      String?  @db.Text
  appetiteLow            Int      @default(4)
  appetiteMedium         Int      @default(9)
  appetiteHigh           Int      @default(14)
  appetiteCategoryConfig Json?

  // Snapshot configuration
  snapshotFrequency   SnapshotFrequency @default(WEEKLY)
  snapshotMateriality Int               @default(2)

  // Relationships
  users         User[]
  riskRegisters RiskRegister[]
  assessments   Assessment[]
  auditLogs     AuditLog[]
  kris          Kri[]
  emailSubmissions EmailSubmission[]
  scoringProfiles  ScoringProfile[]
  snapshots        RiskSnapshot[]

  @@map("organisations")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role       @default(VIEWER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Organisation membership
  orgId        String
  organisation Organisation @relation(fields: [orgId], references: [id])

  // Invite system
  inviteToken        String?   @unique
  inviteTokenExpires DateTime?
  invitedById        String?
  invitedBy          User?     @relation("UserInvites", fields: [invitedById], references: [id])
  invitedUsers       User[]    @relation("UserInvites")

  // Password reset
  resetToken        String?   @unique
  resetTokenExpires DateTime?

  // Dashboard customization
  dashboardLayout   Json?     // Stores react-grid-layout configuration

  // Auth relationships
  accounts Account[]
  sessions Session[]

  // Activity
  createdRisks Risk[]     @relation("RiskCreatedBy")
  ownedRisks   Risk[]     @relation("RiskOwnedBy")
  auditLogs    AuditLog[]
  ownedKris    Kri[]
  assignedActions  TreatmentAction[] @relation("ActionAssignee")
  createdActions   TreatmentAction[] @relation("ActionCreatedBy")
  createdMappings  RegulatoryMapping[] @relation("MappingCreatedBy")
  reportedIncidents    Incident[]    @relation("IncidentReportedBy")
  assignedIncidents    Incident[]    @relation("IncidentAssignee")
  triggeredAssessments Assessment[]  @relation("AssessmentTriggeredBy")

  @@map("users")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum Role {
  OWNER
  ADMIN
  RISK_MANAGER
  EDITOR
  VIEWER
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================
// RISK MANAGEMENT CORE
// ============================================

model RiskRegister {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      RegisterStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Organisation ownership
  orgId        String
  organisation Organisation @relation(fields: [orgId], references: [id])

  // Relationships
  risks       Risk[]
  assessments Assessment[]
  uploads     Upload[]

  @@map("risk_registers")
}

enum RegisterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Risk {
  id          String       @id @default(cuid())
  refCode     String
  title       String
  description String       @db.Text
  category    RiskCategory

  // Inherent risk scores (before controls)
  inherentLikelihood Int
  inherentImpact     Int
  inherentScore      Int

  // Residual risk scores (after controls)
  residualLikelihood Int
  residualImpact     Int
  residualScore      Int

  // Risk response
  response             RiskResponse         @default(MITIGATE)
  controls             String?              @db.Text
  controlEffectiveness ControlEffectiveness @default(NOT_TESTED)
  rootCause            String?              @db.Text

  // Financial exposure & VaR
  financialExposure Decimal? @db.Decimal(15, 2)
  varValue          Decimal? @db.Decimal(15, 2)

  // Metadata
  status         RiskStatus     @default(OPEN)
  source         RiskSource     @default(MANUAL)
  sourceRef      String?
  workflowStatus WorkflowStatus @default(APPROVED)
  dueDate        DateTime?
  isOngoing      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relationships
  registerId  String
  register    RiskRegister @relation(fields: [registerId], references: [id])
  createdById String
  createdBy   User         @relation("RiskCreatedBy", fields: [createdById], references: [id])
  ownerId     String?
  owner       User?        @relation("RiskOwnedBy", fields: [ownerId], references: [id])

  // AI analysis
  aiAnalysis AIAnalysis?

  // Treatment actions
  treatmentActions TreatmentAction[]

  // Regulatory mappings
  regulatoryMappings RegulatoryMapping[]

  // Incidents
  incidents Incident[]

  @@unique([registerId, refCode])
  @@map("risks")
}

enum RiskCategory {
  STRATEGIC
  OPERATIONAL
  FINANCIAL
  COMPLIANCE
  TECHNOLOGY
  REPUTATIONAL
  ENVIRONMENTAL
  PEOPLE
}

enum RiskResponse {
  AVOID
  MITIGATE
  TRANSFER
  ACCEPT
}

enum RiskStatus {
  OPEN
  IN_PROGRESS
  MONITORING
  CLOSED
  ARCHIVED
}

enum RiskSource {
  MANUAL
  EMAIL
  EXCEL
  API
}

enum WorkflowStatus {
  INBOX
  TRIAGE
  ASSIGNED
  APPROVED
}

enum ControlEffectiveness {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
  NOT_TESTED
  NOT_APPLICABLE
}

// ============================================
// AI ANALYSIS
// ============================================

model AIAnalysis {
  id     String @id @default(cuid())
  riskId String @unique
  risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)

  // AI-generated insights
  summary            String   @db.Text
  suggestedControls  String?  @db.Text
  scoreJustification String?  @db.Text
  relatedRisks       String[]

  // Metadata
  modelVersion String
  generatedAt  DateTime @default(now())
  confidence   Float?

  @@map("ai_analyses")
}

// ============================================
// ASSESSMENTS & VYTL SCORE
// ============================================

model Assessment {
  id          String           @id @default(cuid())
  type        AssessmentType
  status      AssessmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  // Vytl Score (0-100)
  vytlScore      Int?
  vytlGrade      String?
  scoreBreakdown Json?

  // Relationships
  orgId        String
  organisation Organisation  @relation(fields: [orgId], references: [id])
  registerId   String?
  register     RiskRegister? @relation(fields: [registerId], references: [id])
  triggeredById String?
  triggeredBy   User?         @relation("AssessmentTriggeredBy", fields: [triggeredById], references: [id])

  @@map("assessments")
}

enum AssessmentType {
  INITIAL
  QUARTERLY
  ANNUAL
  AD_HOC
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================
// KRI MONITORING
// ============================================

model Kri {
  id             String       @id @default(cuid())
  name           String
  description    String?
  unit           String
  direction      KriDirection
  currentValue   Decimal?
  thresholdGreen Decimal
  thresholdAmber Decimal
  thresholdRed   Decimal
  status         KriStatus    @default(GREEN)
  lastUpdated    DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relationships
  orgId        String
  organisation Organisation @relation(fields: [orgId], references: [id])
  ownerId      String?
  owner        User?        @relation(fields: [ownerId], references: [id])

  @@map("kris")
}

enum KriDirection {
  HIGHER_IS_WORSE
  LOWER_IS_WORSE
}

enum KriStatus {
  GREEN
  AMBER
  RED
}

// ============================================
// SCORING ENGINE
// ============================================

model ScoringProfile {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  industry    String?

  // Dimension weights (must sum to 100)
  weightBase          Int @default(40)  // Base L×I score
  weightControlQuality Int @default(20) // Control description quality
  weightVelocity      Int @default(15)  // Rate of score change
  weightCorrelation   Int @default(15)  // Cross-risk correlation
  weightKriAlignment  Int @default(10)  // KRI trend alignment

  // Category importance multipliers (1.0 = normal, >1.0 = higher importance)
  categoryMultipliers Json? // Record<RiskCategory, number>

  // Thresholds
  thresholdLow    Int @default(25)  // Below = low risk
  thresholdMedium Int @default(50)  // Below = medium risk
  thresholdHigh   Int @default(75)  // Below = high, above = critical

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organisation ownership
  orgId        String
  organisation Organisation @relation(fields: [orgId], references: [id])

  // Relationships
  rules        ScoringRule[]
  scoreHistory ScoreHistory[]

  @@unique([orgId, isDefault])
  @@map("scoring_profiles")
}

model ScoringRule {
  id          String @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  priority    Int     @default(50) // 1-100, lower = applied first

  // Condition (what triggers the rule)
  conditionField    String  // e.g. "category", "status", "residualScore"
  conditionOperator String  // "equals", "greaterThan", "lessThan", "contains", "isEmpty"
  conditionValue    String  // e.g. "COMPLIANCE", "25", "OPEN"

  // Effect
  scoreModifier Int    // -25 to +25 points adjustment
  modifierType  String @default("absolute") // "absolute" or "percentage"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  profileId String
  profile   ScoringProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("scoring_rules")
}

model ScoreHistory {
  id        String   @id @default(cuid())
  riskId    String
  createdAt DateTime @default(now())

  // Score snapshot
  compositeScore     Int   // 0-100 weighted composite
  baseScore          Int   // Traditional L×I normalized
  controlQualityScore Int  // Control quality dimension
  velocityScore      Int   // Velocity dimension
  correlationScore   Int   // Correlation dimension
  kriAlignmentScore  Int   // KRI alignment dimension

  // Breakdown stored as JSON for flexibility
  breakdown Json?

  // Profile used for this calculation
  profileId String?
  profile   ScoringProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([riskId, createdAt])
  @@map("score_history")
}

// ============================================
// EMAIL SUBMISSIONS
// ============================================

model EmailSubmission {
  id              String              @id @default(cuid())
  senderEmail     String
  senderUserId    String?
  subject         String
  bodyPreview     String              @db.Text
  status          EmailSubmissionStatus @default(PENDING)
  rejectionReason String?
  createdRiskId   String?
  processedAt     DateTime?
  createdAt       DateTime            @default(now())

  // Relationships
  orgId        String
  organisation Organisation @relation(fields: [orgId], references: [id])

  @@map("email_submissions")
}

enum EmailSubmissionStatus {
  PENDING
  PROCESSED
  REJECTED
}

// ============================================
// FILE UPLOADS & AUDIT
// ============================================

model Upload {
  id          String       @id @default(cuid())
  filename    String
  s3Key       String
  mimeType    String
  sizeBytes   Int
  status      UploadStatus @default(PENDING)
  processedAt DateTime?
  errorMsg    String?
  createdAt   DateTime     @default(now())

  registerId String
  register   RiskRegister @relation(fields: [registerId], references: [id])

  @@map("uploads")
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  orgId        String
  organisation Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================
// TREATMENT ACTIONS
// ============================================

model TreatmentAction {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  priority    ActionPriority @default(MEDIUM)
  status      ActionStatus   @default(OPEN)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  riskId      String
  risk        Risk           @relation(fields: [riskId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?          @relation("ActionAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User           @relation("ActionCreatedBy", fields: [createdById], references: [id])
  @@index([riskId])
  @@map("treatment_actions")
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================
// REGULATORY MAPPINGS
// ============================================

model RegulatoryMapping {
  id              String           @id @default(cuid())
  requirementCode String
  complianceStatus ComplianceStatus @default(NOT_ASSESSED)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  riskId      String
  risk        Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("MappingCreatedBy", fields: [createdById], references: [id])

  @@unique([riskId, requirementCode])
  @@index([riskId])
  @@map("regulatory_mappings")
}

enum ComplianceStatus {
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  NOT_ASSESSED
  NOT_APPLICABLE
}

// ============================================
// INCIDENTS
// ============================================

model Incident {
  id           String           @id @default(cuid())
  title        String
  description  String?          @db.Text
  severity     IncidentSeverity @default(MEDIUM)
  status       IncidentStatus   @default(OPEN)
  occurredAt   DateTime
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  riskId       String
  risk         Risk             @relation(fields: [riskId], references: [id], onDelete: Cascade)
  reportedById String
  reportedBy   User             @relation("IncidentReportedBy", fields: [reportedById], references: [id])
  assigneeId   String?
  assignee     User?            @relation("IncidentAssignee", fields: [assigneeId], references: [id])

  @@index([riskId])
  @@map("incidents")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

// ============================================
// RISK SNAPSHOTS (Movement & Trends)
// ============================================

model RiskSnapshot {
  id   String       @id @default(cuid())
  orgId String
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  snapshotDate DateTime
  snapshotType SnapshotType
  createdBy    String?  // userId if MANUAL, null if automated

  // Vytl Score components (null if no assessment at snapshot time)
  vytlScore    Int?
  vytlGrade    String?
  vytlCoverage Float?  // coverage.score (0-25)
  vytlControl  Float?  // controlEffectiveness.score (0-25)
  vytlMaturity Float?  // maturity.score (0-25)
  vytlTrend    Float?  // trend.score (0-25)

  // Risk distribution by RiskStatus
  totalRisks      Int
  openRisks       Int
  inProgressRisks Int
  monitoringRisks Int
  closedRisks     Int
  archivedRisks   Int

  // Category distribution JSON (e.g. {"STRATEGIC": 5, "OPERATIONAL": 8})
  risksByCategory Json

  // Risk severity counts (residual score vs appetite thresholds)
  lowRiskCount     Int
  mediumRiskCount  Int
  highRiskCount    Int
  extremeRiskCount Int

  // KRI metrics
  krisTotal Int
  krisGreen Int
  krisAmber Int
  krisRed   Int

  // Treatment metrics
  treatmentsTotal         Int
  treatmentsOpen          Int
  treatmentsInProgress    Int
  treatmentsCompleted     Int
  treatmentCompletionRate Float?

  riskDetails RiskSnapshotDetail[]

  createdAt DateTime @default(now())

  @@index([orgId, snapshotDate])
  @@index([orgId, snapshotType])
  @@unique([orgId, snapshotDate, snapshotType])
  @@map("risk_snapshots")
}

model RiskSnapshotDetail {
  id         String       @id @default(cuid())
  snapshotId String
  snapshot   RiskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  riskId   String
  refCode  String
  title    String
  category RiskCategory
  status   RiskStatus

  inherentLikelihood Int
  inherentImpact     Int
  inherentScore      Int

  residualLikelihood Int
  residualImpact     Int
  residualScore      Int

  owner      String?
  ownerEmail String?

  isTopRisk      Boolean @default(false)
  rankAtSnapshot Int?
  fullState      Json?  // populated only when isTopRisk = true

  createdAt DateTime @default(now())

  @@index([snapshotId, riskId])
  @@index([riskId])
  @@map("risk_snapshot_details")
}

enum SnapshotType {
  BASELINE
  SCHEDULED
  MANUAL
  QUARTERLY
}

enum SnapshotFrequency {
  WEEKLY
  MONTHLY
}